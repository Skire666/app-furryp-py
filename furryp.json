{
  "extend-exclude": ["tests"],
  "rules": {
    "function-too-long": { "max-lines": 26 },
    "file-too-long": { "max-lines": 1000 },
    "halstead-file": { "metric": "volume", "max": 14000 },
    "halstead-function": { "metric": "volume", "max": 1200 },
    "cognitive-complexity": { "max": 16 },
    "too-complex-class": { "max-class-complexity": 80 },
    "demeter-chain": {
      "max-depth": 3,
      "ignore-roots": ["self", "cls"],
      "ignore-imported-modules": true,
      "count-calls": false
    },
    "too-many-instance-attributes": { "max-instance-attributes": 20 },
    "layer-violation": {
      "contracts": [
        {
          "type": "layers",
          "name": "furryp-layers",
          "layers": [
            "furryp.cli",
            ["furryp.output", "furryp.report", "furryp.fix"],
            "furryp.lint",
            "furryp.config",
            "furryp.rules",
            "furryp.metrics",
            "furryp.core"
          ]
        }
      ]
    }
  }
}
